# Shared beta unlock. Polar entitlements are stubbed in v1.
BETA_ACCESS=flatqr-beta

# Container PaaS (SnapDeploy) injects PORT. Listen on 0.0.0.0 — see scripts/start.cjs.
# PORT=8080
# HOSTNAME=0.0.0.0

# Optional. Defaults to file:./data/flatqr.db (SQLite via libsql).
# For Turso: libsql://<db>-<org>.turso.io with TURSO_AUTH_TOKEN.
DATABASE_URL=
# TURSO_AUTH_TOKEN=
