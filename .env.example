# Shared beta unlock. Polar entitlements are stubbed in v1.
BETA_ACCESS=flatqr-beta

# Container PaaS (SnapDeploy) injects PORT. Listen on 0.0.0.0 — see scripts/start.cjs.
# PORT=8080
# HOSTNAME=0.0.0.0

# Optional remote libSQL/Turso. Defaults to file:./data/flatqr.db (SQLite via libsql).
# Do NOT name this DATABASE_URL — SnapDeploy Free then demands a paid Postgres add-on.
# LIBSQL_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=
